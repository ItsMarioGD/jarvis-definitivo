# Configuración de variables de entorno para Jarvis

# API Key Eleven Labs (obtén tu key en: https://elevenlabs.io/)
ELEVENLABS_API_KEY=tu_api_key_aqui

# Voice ID masculino: Spuds Oxley. Selecciona otra voz masculina en ElevenLabs si lo prefieres.
ELEVENLABS_VOICE_ID=NOpBlnGInO9m6vDvFkFC

# Transporte WebRTC
TRANSPORT_HOST=localhost
TRANSPORT_PORT=3000

# Modo de operación
JARVIS_MODE=full

# Respaldo cuando ElevenLabs no pueda sintetizar (por ejemplo, sin créditos).
# Usa el sintetizador de voz integrado de Windows; cambia a "none" para solo texto.
JARVIS_TTS_FALLBACK=windows

# ── ULTRON ───────────────────────────────────────────────────────────────────
# Activa el agente ULTRON (superinteligencia autónoma hermana de Jarvis)
ULTRON_MODE=1

# Puerto del backend web de ULTRON (por defecto 8766, Jarvis usa 8765)
ULTRON_PORT=8766

# Modelo de Claude para ULTRON (opcional: vacio = el mismo que Jarvis).
# Por ejemplo claude-fable-5-1 para que suene distinto al de Jarvis.
ULTRON_MODEL=

# Voice ID de ElevenLabs exclusivo para ULTRON (opcional)
# Deja vacío para usar la misma voz que Jarvis
# Recomendado: busca una voz grave y fría en https://elevenlabs.io/voice-library
ULTRON_VOICE_ID=

# Activar saludo de arranque de ULTRON (1=sí, 0=no)
# Por defecto siempre saluda al arrancar
ULTRON_SALUDAR=1

# ── BOT DE TELEGRAM ──────────────────────────────────────────────────────────
# Token del bot creado con @BotFather. Alternativa a guardarlo por voz con
# «configura mi bot de telegram en TU_TOKEN» (que lo escribe en
# <Descargas>/JARVIS/Prefs/telegram.json).
# El bot registra todo en jarvis_log/telegram_bot.log: mira ahí si no responde.
TELEGRAM_BOT_TOKEN=

# ── CONECTORES (Google Calendar) ─────────────────────────────────────────────
# Normalmente NO hace falta tocar nada: deja el JSON que descargas de Google
# Cloud Console (ID de cliente OAuth -> Aplicacion de escritorio) en la carpeta
# Google/ del proyecto, con el nombre que traiga, y ejecuta:
#     python autorizar_google.py
# Esa carpeta esta en .gitignore: las credenciales nunca deben subirse al repo.
# Estas dos variables solo son para forzar otra ruta.
# GOOGLE_CREDENTIALS_JSON=Google/client_secret_....json
# GOOGLE_TOKEN_JSON=Google/token.json

# Puerto del servidor local que se usa al autorizar con Google. Es FIJO a
# proposito: con credenciales de tipo «Aplicacion web» hay que registrar
# http://localhost:8088/ en los URI de redireccionamiento del ID de cliente.
GOOGLE_OAUTH_PORT=8088

# Zona horaria de los eventos que cree JARVIS
JARVIS_TIMEZONE=Europe/Madrid

# Puertos de los servidores MCP (los mismos que arranca start_jarvis.bat)
HA_MCP_PORT=8001
CAL_MCP_PORT=8002
ANDROID_MCP_PORT=8003

# ── CEREBRO: QWEN EN CASA (Ollama) ──────────────────────────────
# El cerebro por defecto vuelve a ser local: no pasa factura, no se queda sin
# saldo y funciona sin internet. Ollama sirve los modelos en forma OpenAI.
#   qwen3:8b            el de trabajo (razona bien, cabe en 6 GB de VRAM)
#   qwen3:4b-instruct   el rapido, para lo corto
#   qwen2.5vl:3b        el que VE: pantalla, fotos y el escaner 3D
# Descargalos con:  ollama pull qwen3:8b
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen3:8b
QWEN_MODEL_RAPIDO=qwen3:4b-instruct
QWEN_VISION_MODEL=qwen2.5vl:3b

# Que cerebro manda: local, pollinations o claude.
# Si lo dejas VACIO, JARVIS elige solo: Pollinations si hay clave puesta abajo
# (contesta en ~2 s donde el de casa tarda 30) y, si no la hay, el de casa.
JARVIS_CEREBRO=

# ── CEREBRO DE LA NUBE: POLLINATIONS ────────────────────────────
# Pasarela abierta con endpoint compatible con OpenAI, asi que JARVIS le habla
# sin traductor ninguno. SIN CLAVE TAMBIEN FUNCIONA, pero a una peticion cada
# 15 segundos, y el bucle de herramientas encadena hasta cuatro: se hace eterno.
#
# PON TU CLAVE AQUI:
#   1. Consiguela en https://enter.pollinations.ai (empieza por sk_)
#   2. Pegala en la linea de abajo (sin comillas ni espacios)
#   3. Reinicia JARVIS
# Comprueba que funciona con:  python revisar.py
# O directamente:              python proveedor_pollinations.py
POLLINATIONS_API_KEY=

# Opcionales. Deja el modelo vacio y JARVIS elige el mejor que tu clave
# alcance de entre los que saben usar HERRAMIENTAS (sin eso JARVIS habla pero
# no actua).
POLLINATIONS_MODELO=
POLLINATIONS_URL=

# ── CEREBRO DE RESERVA: CLAUDE (ANTHROPIC) ──────────────────────
# Opcional. Solo se usa si el cerebro local no contesta, o con
# JARVIS_CEREBRO=claude. Sin clave (o sin saldo) JARVIS sigue funcionando
# con Qwen; deja esto vacio si no la quieres.
# Consiguela en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Solo si tu clave es de ORGANIZACION y no de un workspace: Anthropic responde
# 400 pidiendo la cabecera anthropic-workspace-id. Pon aqui el ID del workspace
# (console.anthropic.com -> Settings -> Workspaces) o crea una clave de
# workspace y deja esto vacio.
ANTHROPIC_WORKSPACE_ID=

# Modelo principal. De mas listo a mas rapido:
#   claude-opus-5                 lo mas capaz (por defecto)
#   claude-sonnet-5               equilibrado
#   claude-haiku-4-5-20251001     el mas rapido y barato
#   claude-fable-5-1              escritura y creatividad
# Modelo principal. Local: qwen3:8b (por defecto) o qwen3:4b-instruct
# (mas rapido). Para la nube: claude-sonnet-5, claude-opus-5,
# claude-haiku-4-5-20251001, claude-fable-5-1.
JARVIS_MODELO=qwen3:8b

# Tope de tokens de salida: el razonamiento de Claude gasta del mismo
# presupuesto, y por debajo de ~2048 piensa y se queda sin respuesta.
JARVIS_MAX_TOKENS_CLAUDE=2048

# Tope de gasto diario en dolares (0 = sin tope). Al alcanzarlo, JARVIS avisa
# en vez de seguir llamando a la API.
JARVIS_PRESUPUESTO_USD=1.0
