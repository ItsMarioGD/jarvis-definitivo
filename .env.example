# Configuración de variables de entorno para Jarvis

# API Key Eleven Labs (obtén tu key en: https://elevenlabs.io/)
ELEVENLABS_API_KEY=tu_api_key_aqui

# Voz global de respaldo (masculina). Si la dejas vacia, jarvis_voice.py aplica
# la voz masculina del perfil de cada agente, de modo que nunca suena en femenino.
#   Masculinas recomendadas:
#     onwK4e9ZLuTAKqWW03F9  Daniel  - britanico, autoritario   (JARVIS)
#     N2lVS1w4EtoT3dr4eOWO  Callum  - transatlantico, intenso  (ULTRON)
#     JBFqnCBsd6RMkjVDRZzb  George  - britanico, calido
#     pNInz6obpgDQGcFmaJgB  Adam    - americano, profundo
#     NOpBlnGInO9m6vDvFkFC  Spuds Oxley
#   NO uses 21m00Tcm4TlvDq8ikWAM (Rachel): es una voz femenina.
ELEVENLABS_VOICE_ID=

# Voz exclusiva de JARVIS (opcional). Tiene prioridad sobre ELEVENLABS_VOICE_ID.
JARVIS_VOICE_ID=

# Voz Piper local (offline, gratis). Vacio = la del perfil del agente.
#   es_MX-claude-high      mejor calidad, neutro latino
#   es_ES-sharvard-medium  castellano mas grave   (ULTRON por defecto)
#   es_ES-davefx-medium    castellano equilibrado (JARVIS por defecto)
#   es_MX-ald-medium       latino calido
#   es_ES-carlfm-x_low     el mas ligero y rapido
# Todas son masculinas: la unica femenina del catalogo (es_AR-daniela-high)
# queda deliberadamente fuera de jarvis_piper.py.
PIPER_VOICE=

# Configuración Qwen 3.4b
# Opción 1: Servidor OpenAI-compatible (vLLM, Ollama, etc.)
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama

# Opción 2: Ollama local (solo necesita base URL)
# QWEN_BASE_URL=http://localhost:11434
# QWEN_API_KEY=ollama

# Transporte WebRTC
TRANSPORT_HOST=localhost
TRANSPORT_PORT=3000

# Modo de operación
JARVIS_MODE=full

# Respaldo cuando ElevenLabs no pueda sintetizar (por ejemplo, sin créditos).
# Usa el sintetizador de voz integrado de Windows; cambia a "none" para solo texto.
JARVIS_TTS_FALLBACK=windows

# ── ULTRON ───────────────────────────────────────────────────────────────────
# Activa el agente ULTRON (superinteligencia autónoma hermana de Jarvis)
ULTRON_MODE=1

# Puerto del backend web de ULTRON (por defecto 8766, Jarvis usa 8765)
ULTRON_PORT=8766

# Modelo LLM para ULTRON (opcional: deja vacío para usar el mismo que Jarvis)
# Para más potencia usa qwen3:8b si tienes VRAM suficiente (>= 8GB)
ULTRON_MODEL=

# Voz de ElevenLabs exclusiva para ULTRON (opcional). Tiene prioridad sobre
# ELEVENLABS_VOICE_ID. Vacio = Callum (N2lVS1w4EtoT3dr4eOWO), masculina e intensa.
# Si buscas otra, elige una voz masculina grave en https://elevenlabs.io/voice-library
ULTRON_VOICE_ID=

# Activar saludo de arranque de ULTRON (1=sí, 0=no)
# Por defecto siempre saluda al arrancar
ULTRON_SALUDAR=1
